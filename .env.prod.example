# Host / domain
TZ=America/Toronto
MERLIN_SERVER_NAME=api.ivia.quebec ivia.quebec
NEXT_PUBLIC_MERLIN_API_BASE_URL=https://api.ivia.quebec

# TLS paths used by nginx once Let's Encrypt certificates exist
SSL_CERTIFICATE_PATH=/etc/letsencrypt/live/api.ivia.quebec/fullchain.pem
SSL_CERTIFICATE_KEY_PATH=/etc/letsencrypt/live/api.ivia.quebec/privkey.pem

# PostgreSQL
POSTGRES_DB=merlin_v1
POSTGRES_USER=merlin
POSTGRES_PASSWORD=change-me-now

# FastAPI / MERLIN
MERLIN_ENV=production
MERLIN_APP_NAME=MERLIN API
MERLIN_API_V1_PREFIX=/v1
MERLIN_AUTH_SECRET_KEY=change-this-merlin-auth-secret-min-32-chars
MERLIN_AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=120
MERLIN_MEDIA_PROVIDER_CODE=livekit
MERLIN_MEDIA_RECORDING_ENABLED=true
MERLIN_MEDIA_RECORDING_STRATEGY=livekit_egress
MERLIN_MEDIA_LIVEKIT_PUBLIC_WS_URL=wss://ivia.quebec/livekit
MERLIN_AUTO_CREATE_TABLES=false
MERLIN_CORS_ORIGINS=https://ivia.quebec,https://www.ivia.quebec,https://api.ivia.quebec

# AI providers
ANTHROPIC_API_KEY=
ASSEMBLYAI_API_KEY=

# LiveKit internal auth / server
LIVEKIT_API_KEY=merlin-livekit-key
LIVEKIT_API_SECRET=change-this-livekit-secret-min-32-chars
LIVEKIT_LOG_LEVEL=info
LIVEKIT_USE_EXTERNAL_IP=true
LIVEKIT_RTC_PORT_RANGE_START=50000
LIVEKIT_RTC_PORT_RANGE_END=50020

# LiveKit recording storage
LIVEKIT_RECORDING_STORAGE=local
# True file export in production also requires the `redis` and `livekit-egress`
# services from `docker-compose.prod.yml`.
LIVEKIT_S3_ENDPOINT=
LIVEKIT_S3_BUCKET=
LIVEKIT_S3_ACCESS_KEY=
LIVEKIT_S3_SECRET_KEY=
LIVEKIT_S3_REGION=
LIVEKIT_S3_FORCE_PATH_STYLE=true

# ──────────────────────────────────────────────────────────────────────
# SMTP OVH — emails transactionnels (souverain, pas de Resend)
# ──────────────────────────────────────────────────────────────────────
MERLIN_SMTP_HOST=ssl0.ovh.net
MERLIN_SMTP_PORT=587
MERLIN_SMTP_USE_TLS=true
MERLIN_SMTP_USERNAME=
MERLIN_SMTP_PASSWORD=
MERLIN_SMTP_FROM_EMAIL=noreply@ivia.quebec
MERLIN_SMTP_FROM_NAME=IVIA

# ──────────────────────────────────────────────────────────────────────
# MODE PILOTE — override emails vers Gmail (P1 uniquement)
# Mettre MERLIN_PILOT_EMAIL_OVERRIDE=0 pour désactiver en P2
# ──────────────────────────────────────────────────────────────────────
MERLIN_PILOT_EMAIL_OVERRIDE=1
MERLIN_PILOT_CLIENT_PRACTITIONER_EMAIL=davidphaneuf@gmail.com
MERLIN_PILOT_ADMIN_EMAIL=lagent009@gmail.com

# ──────────────────────────────────────────────────────────────────────
# Stripe — produits IVIA
# ──────────────────────────────────────────────────────────────────────
MERLIN_STRIPE_SECRET_KEY=
MERLIN_STRIPE_WEBHOOK_SECRET=
MERLIN_STRIPE_CHECKOUT_SUCCESS_URL=https://ivia.quebec/checkout/success
MERLIN_STRIPE_CHECKOUT_CANCEL_URL=https://ivia.quebec/checkout/cancel
# Audio asynchrone (45 $ CAD) — produit historique
MERLIN_STRIPE_AUDIO_ASYNC_AMOUNT_CENTS=4500
MERLIN_STRIPE_AUDIO_ASYNC_CURRENCY=cad
# RDV pilote 60 min (80 $ CAD) — Sprint 2
MERLIN_STRIPE_PILOT_60MIN_AMOUNT_CENTS=8000
MERLIN_STRIPE_PILOT_60MIN_CURRENCY=cad
MERLIN_STRIPE_PILOT_60MIN_PRICE_ID=
