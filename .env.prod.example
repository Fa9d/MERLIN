# ══════════════════════════════════════════════════════════════════════
# .env.prod.example — GABARIT ALIGNÉ SUR LE CODE (source : app/core/config.py,
# docker-compose.prod.yml, deploy/backup.sh). Copier vers .env.prod et remplir.
# Chaque clé ici est réellement lue par le code — ne pas inventer de clés.
# ══════════════════════════════════════════════════════════════════════

# Host / domain
TZ=America/Toronto
MERLIN_SERVER_NAME=api.ivia.quebec ivia.quebec
FRONTEND_URL=https://ivia.quebec

# TLS paths used by nginx once Let's Encrypt certificates exist
SSL_CERTIFICATE_PATH=/etc/letsencrypt/live/api.ivia.quebec/fullchain.pem
SSL_CERTIFICATE_KEY_PATH=/etc/letsencrypt/live/api.ivia.quebec/privkey.pem

# PostgreSQL
POSTGRES_DB=merlin_v1
POSTGRES_USER=merlin
POSTGRES_PASSWORD=change-me-now

# FastAPI / MERLIN
MERLIN_ENV=production
MERLIN_APP_NAME=MERLIN API
MERLIN_API_V1_PREFIX=/v1
MERLIN_AUTH_SECRET_KEY=change-this-merlin-auth-secret-min-32-chars
MERLIN_AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=120
MERLIN_MEDIA_PROVIDER_CODE=livekit
MERLIN_MEDIA_RECORDING_ENABLED=true
MERLIN_MEDIA_RECORDING_STRATEGY=livekit_egress
MERLIN_MEDIA_LIVEKIT_PUBLIC_WS_URL=wss://ivia.quebec/livekit
MERLIN_AUTO_CREATE_TABLES=false
MERLIN_CORS_ORIGINS=https://ivia.quebec,https://www.ivia.quebec,https://api.ivia.quebec

# Admin — liste blanche de courriels admin (séparés par virgule)
MERLIN_ADMIN_EMAILS=

# Paiements — true = page simulée (aucun débit) ; auto-actif si pas de clé Stripe
MERLIN_PAYMENTS_TEST_MODE=false

# Taxes (facturation Québec) — laisser vide si non inscrit aux fichiers TPS/TVQ
MERLIN_TAX_REGISTERED=false
MERLIN_TPS_RATE=0.05
MERLIN_TVQ_RATE=0.09975

# AI providers
ANTHROPIC_API_KEY=
# Legacy — transcription tierce, conservée en repli (voir MERLIN_TRANSCRIPTION_PROVIDER)
ASSEMBLYAI_API_KEY=

# Insights comportementaux (LLM) — voir app/services/behavioral_insights.py
MERLIN_INSIGHTS_ENABLED=true
MERLIN_INSIGHTS_MODEL=claude-haiku-4-5-20251001
MERLIN_INSIGHTS_MAX_TOKENS=1200
MERLIN_INSIGHTS_DAILY_CAP=200

# Transcription des séances (Loi 25 : faster-whisper local par défaut si installé)
# auto = faster-whisper si le package est présent dans l'image, sinon AssemblyAI
MERLIN_TRANSCRIPTION_PROVIDER=auto
# medium = bon français québécois ; passer à small si le VPS manque de RAM/CPU
MERLIN_WHISPER_MODEL=medium
MERLIN_WHISPER_DEVICE=cpu
MERLIN_WHISPER_COMPUTE_TYPE=int8

# LiveKit internal auth / server
LIVEKIT_API_KEY=merlin-livekit-key
LIVEKIT_API_SECRET=change-this-livekit-secret-min-32-chars
LIVEKIT_LOG_LEVEL=info
LIVEKIT_USE_EXTERNAL_IP=true
LIVEKIT_RTC_PORT_RANGE_START=50000
LIVEKIT_RTC_PORT_RANGE_END=50020

# LiveKit recording storage
LIVEKIT_RECORDING_STORAGE=local
# True file export in production also requires the `redis` and `livekit-egress`
# services from `docker-compose.prod.yml`.
LIVEKIT_S3_ENDPOINT=
LIVEKIT_S3_BUCKET=
LIVEKIT_S3_ACCESS_KEY=
LIVEKIT_S3_SECRET_KEY=
LIVEKIT_S3_REGION=
LIVEKIT_S3_FORCE_PATH_STYLE=true

# ──────────────────────────────────────────────────────────────────────
# SMTP OVH — emails transactionnels (souverain, pas de Resend)
# NOTE : le code lit SMTP_* (sans préfixe MERLIN_) — voir app/core/config.py
# Défauts code : port 465 + SSL. Pour 587/STARTTLS : SMTP_USE_SSL=false, SMTP_USE_TLS=true
# ──────────────────────────────────────────────────────────────────────
SMTP_HOST=ssl0.ovh.net
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_USE_TLS=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@ivia.quebec
SMTP_FROM_NAME=IVIA

# ──────────────────────────────────────────────────────────────────────
# MODE PILOTE — override emails vers Gmail (P1 uniquement)
# Mettre MERLIN_PILOT_EMAIL_OVERRIDE=0 pour désactiver en P2
# ──────────────────────────────────────────────────────────────────────
MERLIN_PILOT_EMAIL_OVERRIDE=1
MERLIN_PILOT_CLIENT_PRACTITIONER_EMAIL=
MERLIN_PILOT_ADMIN_EMAIL=

# ──────────────────────────────────────────────────────────────────────
# Stripe — produits IVIA (montants en cents CAD, jamais fournis par le client)
# ──────────────────────────────────────────────────────────────────────
MERLIN_STRIPE_SECRET_KEY=
MERLIN_STRIPE_WEBHOOK_SECRET=
MERLIN_STRIPE_CHECKOUT_SUCCESS_URL=https://ivia.quebec/checkout/success
MERLIN_STRIPE_CHECKOUT_CANCEL_URL=https://ivia.quebec/checkout/cancel
# Séance live réservée (75 $ CAD)
MERLIN_STRIPE_SEANCE_AMOUNT_CENTS=7500
MERLIN_STRIPE_SEANCE_CURRENCY=cad
# Séance 30 min (défaut code : 49 $ CAD)
MERLIN_STRIPE_SEANCE_30MIN_AMOUNT_CENTS=4900
# Audio asynchrone — produit historique
MERLIN_STRIPE_AUDIO_ASYNC_AMOUNT_CENTS=4500
MERLIN_STRIPE_AUDIO_ASYNC_CURRENCY=cad
# Enregistrement solo (35 $ CAD)
MERLIN_STRIPE_SOLO_AMOUNT_CENTS=3500
MERLIN_STRIPE_SOLO_CURRENCY=cad

# ──────────────────────────────────────────────────────────────────────
# Matomo — mesure d'audience souveraine (stats.ivia.quebec, Loi 25)
# ──────────────────────────────────────────────────────────────────────
MATOMO_DB_PASSWORD=change-me-now
MATOMO_DB_ROOT_PASSWORD=change-me-now

# ──────────────────────────────────────────────────────────────────────
# Sauvegarde chiffrée hors-site (Loi 25) — voir docs/ops-sauvegarde.md
# Sans ces variables : sauvegarde LOCALE non chiffrée (mode dev)
# ──────────────────────────────────────────────────────────────────────
MERLIN_BACKUP_PASSPHRASE=
MERLIN_BACKUP_LOCAL_DIR=
MERLIN_BACKUP_LOCAL_KEEP=
OVH_S3_ENDPOINT=
OVH_S3_REGION=
OVH_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
