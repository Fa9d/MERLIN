upstream merlin_frontend {
    server frontend:3000;
}

upstream merlin_backend {
    server backend:8000;
}

server {
    listen 80;
    server_name ivia.quebec www.ivia.quebec api.ivia.quebec;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    server_name ivia.quebec www.ivia.quebec;

    ssl_certificate /etc/letsencrypt/live/ivia.quebec/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ivia.quebec/privkey.pem;

    client_max_body_size 64m;

    location / {
        proxy_pass http://merlin_frontend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}

server {
    listen 443 ssl http2;
    server_name api.ivia.quebec;

    ssl_certificate /etc/letsencrypt/live/api.ivia.quebec/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/api.ivia.quebec/privkey.pem;

    client_max_body_size 64m;

    location / {
        proxy_pass http://merlin_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
