// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum RecordStatus {
  draft
  active
  validated
  closed
  deprecated
  archived
}

enum DataSensitivityClass {
  low
  moderate
  high
  restricted
}

enum RetentionClass {
  ephemeral
  short_term
  standard
  extended
  archival
}

enum HumanValidationStatus {
  not_required
  pending
  validated
  rejected
  superseded
}

enum WorkspaceScope {
  production
  supervision
  research
}

enum SourceType {
  human_input
  audio_source
  transcript_source
  derived_by_rule
  derived_by_ai
  manual_summary
  system_event
}

enum RequestForCode {
  self
  relative
  other
}

enum NeedCode {
  clarification
  support
  orientation
  loneliness
  distress
  other
}

enum SessionModeCode {
  standard
  intake
  follow_up
}

enum SessionChannelCode {
  phone
  video
  in_person
  async
}

enum SessionStatusCode {
  scheduled
  in_progress
  completed
  cancelled
  no_show
  escalated
}

enum ConsentTypeCode {
  consent_session
  consent_session_note
  consent_history
  consent_recording
  consent_transcription
  consent_client_delivery
  consent_third_party_transmission
}

enum RevocationScopeCode {
  future_only
  future_and_pending
}

enum GrantedByActorCode {
  client
  operator
  system
}

enum StorageClassCode {
  hot
  cold
  offline_archive
}

enum FactTypeCode {
  reported_need
  reported_attempt
  reported_blocker
  reported_resource
  red_flag_signal
  theme
}

enum RiskLevelCode {
  non_urgent
  watch
  priority
  urgent
}

enum ConfidenceLevelCode {
  low
  moderate
  high
}

enum OrientationTargetCode {
  internal_follow_up
  doctor
  psychologist
  psychiatrist
  social_worker
  community_resource
  crisis_service
  emergency_service
  complementary_practice
}

enum OrientationConfidenceCode {
  exploratory
  recommended
  priority
  urgent_escalation
}

enum OrientationPriorityCode {
  low
  normal
  high
  urgent
}

enum DocumentTypeCode {
  entry_summary
  session_summary
  care_journal_entry
  relay_note
}

enum GenerationModeCode {
  manual
  template
  ai_assisted
}

enum GeneratedFromScopeCode {
  intake
  session
  history
}

enum AnalysisNextStepCode {
  continue_to_structure
  clarify_major_point
  stabilize_rhythm_and_load
  mobilize_relational_resource
  orient_to_appropriate_service
  propose_follow_up
  escalate_immediate_relay
}

enum RecipientTypeCode {
  client
  doctor
  psychologist
  psychiatrist
  social_worker
  community_resource
  other
}

enum TransmissionBasisCode {
  explicit_consent
  legal_obligation
  safety_exception
}

enum EventTypeCode {
  intake_created
  session_completed
  orientation_added
  document_delivered
  transmission_done
}

enum ReferentialFamilyCode {
  needs
  risks
  orientations
  consent_texts
  documents
}

enum ActorTypeCode {
  user
  system
  client
}

enum TargetObjectTypeCode {
  client
  intake_request
  consent
  session
  session_note
  audio_source
  transcript_source
  derived_fact
  risk_assessment
  orientation
  document_derived
  transmission
}

enum ActionCode {
  create
  update
  validate
  reject
  deliver
  transmit
  archive
  delete_logical
  view_restricted
  generate_ai_output
}

model Client {
  id                    String               @id @default(cuid())
  publicClientCode      String               @unique
  firstNameOrAlias      String
  lastName              String?
  email                 String?
  phone                 String?
  languageCode          String               @default("fr-CA")
  timezone              String               @default("America/Toronto")
  territoryCode         String               @default("QC")
  isAdultConfirmed      Boolean              @default(false)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  recordStatus          RecordStatus         @default(active)
  dataSensitivityClass  DataSensitivityClass @default(high)
  intakeRequests        IntakeRequest[]
  consents              Consent[]
  sessions              Session[]
  sessionNotes          SessionNote[]
  audioSources          AudioSource[]
  transcriptSources     TranscriptSource[]
  derivedFacts          DerivedFact[]
  riskAssessments       RiskAssessment[]
  orientations          Orientation[]
  documents             DocumentDerived[]
  transmissions         ThirdPartyTransmission[]
  timelineEvents        ClientTimelineEvent[]
}

model IntakeRequest {
  id                    String               @id @default(cuid())
  clientId              String
  requestChannelCode    String               @default("web")
  requestForCode        RequestForCode
  primaryNeedCode       NeedCode
  perceivedUrgencyCode  RiskLevelCode
  supportAlreadyInPlace Boolean              @default(false)
  requestedOutcomeText  String?
  entrySummaryText      String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  recordStatus          RecordStatus         @default(active)
  referentialVersion    String               @default("v1")
  client                Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  sessions              Session[]

  @@index([clientId, createdAt])
}

model Consent {
  id                  String               @id @default(cuid())
  clientId            String
  sessionId           String?
  consentTypeCode     ConsentTypeCode
  consentValue        Boolean
  consentVersionCode  String
  grantedByActorCode  GrantedByActorCode
  grantedAt           DateTime
  revokedAt           DateTime?
  revocationScopeCode RevocationScopeCode?
  notes               String?
  recordStatus        RecordStatus         @default(active)
  client              Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  session             Session?             @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  audioSources        AudioSource[]

  @@index([clientId, consentTypeCode, grantedAt])
}

model Session {
  id                    String               @id @default(cuid())
  clientId              String
  intakeRequestId       String?
  sessionSequenceNumber Int
  sessionModeCode       SessionModeCode      @default(standard)
  sessionChannelCode    SessionChannelCode   @default(phone)
  scheduledStartAt      DateTime?
  actualStartAt         DateTime?
  actualEndAt           DateTime?
  durationMinutes       Int?
  roomName              String?
  roomSid               String?
  egressId              String?
  audioFilePath         String?
  operatorUserId        String?
  sessionStatusCode     SessionStatusCode    @default(scheduled)
  recordStatus          RecordStatus         @default(active)
  dataSensitivityClass  DataSensitivityClass @default(high)
  retentionClass        RetentionClass       @default(standard)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  client                Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  intakeRequest         IntakeRequest?       @relation(fields: [intakeRequestId], references: [id], onDelete: SetNull)
  consents              Consent[]
  sessionNote           SessionNote?
  audioSources          AudioSource[]
  transcriptSources     TranscriptSource[]
  derivedFacts          DerivedFact[]
  riskAssessments       RiskAssessment[]
  orientations          Orientation[]
  documents             DocumentDerived[]
  transmissions         ThirdPartyTransmission[]
  timelineEvents        ClientTimelineEvent[]

  @@unique([clientId, sessionSequenceNumber])
  @@index([clientId, actualStartAt])
}

model SessionNote {
  id                    String                @id @default(cuid())
  sessionId             String                @unique
  clientId              String
  noteTemplateVersion   String
  presentingNeedText    String
  keyElementsText       String
  vigilanceSummaryText  String
  vigilanceLevelCode    RiskLevelCode?
  nextStepSummaryText   String
  nextStepTypeCode      AnalysisNextStepCode?
  operatorSummaryText   String
  coeurSummaryText      String?
  corpsSummaryText      String?
  espritSummaryText     String?
  etreSummaryText       String?
  immediateContextText  String?
  contextFactorsJson    Json?
  contextHypothesesJson Json?
  identifiedTensionsJson Json?
  clientFacingSummaryText String?
  supervisionSummaryText String?
  researchNotesText     String?
  modelUsed             String?
  promptVersion         String?
  complexityScore       Int?
  validatedByPractitioner Boolean             @default(false)
  validatedAt          DateTime?
  practitionerCorrections Json?
  humanValidationStatus HumanValidationStatus @default(not_required)
  createdByUserId       String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  recordStatus          RecordStatus          @default(active)
  retentionClass        RetentionClass        @default(standard)
  session               Session               @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  client                Client                @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model AudioSource {
  id                    String               @id @default(cuid())
  clientId              String
  sessionId             String
  storageProviderCode   String
  storageClassCode      StorageClassCode
  storageObjectPath     String
  fileFormatCode        String
  fileSizeBytes         BigInt
  checksumSha256        String
  recordedAt            DateTime
  uploadedAt            DateTime             @default(now())
  archivedAt            DateTime?
  deletedAt             DateTime?
  retentionUntil        DateTime?
  consentSnapshotId     String
  recordStatus          RecordStatus         @default(active)
  dataSensitivityClass  DataSensitivityClass @default(restricted)
  retentionClass        RetentionClass       @default(short_term)
  client                Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  session               Session              @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  consentSnapshot       Consent              @relation(fields: [consentSnapshotId], references: [id], onDelete: Restrict)
  transcripts           TranscriptSource[]

  @@index([sessionId])
}

model TranscriptSource {
  id                       String                @id @default(cuid())
  clientId                 String
  sessionId                String
  audioSourceId            String?
  transcriptionProviderCode String
  transcriptText           String
  languageCode             String                @default("fr-CA")
  qualityScore             Float?
  generationStartedAt      DateTime?
  generationCompletedAt    DateTime?
  humanValidationStatus    HumanValidationStatus @default(pending)
  recordStatus             RecordStatus          @default(active)
  dataSensitivityClass     DataSensitivityClass  @default(restricted)
  retentionClass           RetentionClass        @default(extended)
  sourceType               SourceType            @default(transcript_source)
  client                   Client                @relation(fields: [clientId], references: [id], onDelete: Cascade)
  session                  Session               @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  audioSource              AudioSource?          @relation(fields: [audioSourceId], references: [id], onDelete: SetNull)

  @@index([sessionId])
}

model DerivedFact {
  id                    String                @id @default(cuid())
  clientId              String
  sessionId             String
  sourceOriginCode      String
  factTypeCode          FactTypeCode
  factText              String
  factJson              Json?
  confidenceScore       Float?
  humanValidationStatus HumanValidationStatus @default(pending)
  generatedByCode       String
  promptOrRuleVersion   String?
  createdAt             DateTime              @default(now())
  recordStatus          RecordStatus          @default(active)
  workspaceScope        WorkspaceScope        @default(production)
  sourceType            SourceType            @default(derived_by_ai)
  client                Client                @relation(fields: [clientId], references: [id], onDelete: Cascade)
  session               Session               @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model RiskAssessment {
  id                    String                @id @default(cuid())
  clientId              String
  sessionId             String
  riskLevelCode         RiskLevelCode
  riskReasonSummaryText String
  confidenceLevelCode   ConfidenceLevelCode
  requiresEscalation    Boolean               @default(false)
  humanValidationStatus HumanValidationStatus @default(pending)
  validatedByUserId     String?
  createdAt             DateTime              @default(now())
  recordStatus          RecordStatus          @default(active)
  workspaceScope        WorkspaceScope        @default(production)
  client                Client                @relation(fields: [clientId], references: [id], onDelete: Cascade)
  session               Session               @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model Orientation {
  id                        String                    @id @default(cuid())
  clientId                  String
  sessionId                 String
  orientationTargetCode     OrientationTargetCode
  orientationReasonText     String
  orientationConfidenceCode OrientationConfidenceCode
  orientationPriorityCode   OrientationPriorityCode
  humanValidationStatus     HumanValidationStatus     @default(pending)
  validatedByUserId         String?
  createdAt                 DateTime                  @default(now())
  recordStatus              RecordStatus              @default(active)
  client                    Client                    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  session                   Session                   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model DocumentDerived {
  id                     String                @id @default(cuid())
  clientId               String
  sessionId              String?
  documentTypeCode       DocumentTypeCode
  documentTitle          String
  documentBodyText       String?
  documentPayloadJson    Json?
  generationModeCode     GenerationModeCode
  generatedFromScopeCode GeneratedFromScopeCode
  humanValidationStatus  HumanValidationStatus @default(pending)
  deliveredToClient      Boolean               @default(false)
  deliveredAt            DateTime?
  recordStatus           RecordStatus          @default(active)
  retentionClass         RetentionClass        @default(standard)
  createdAt              DateTime              @default(now())
  client                 Client                @relation(fields: [clientId], references: [id], onDelete: Cascade)
  session                Session?              @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  transmissions          ThirdPartyTransmission[]

  @@index([clientId, createdAt])
}

model ThirdPartyTransmission {
  id                     String                @id @default(cuid())
  clientId               String
  sessionId              String?
  documentDerivedId      String
  recipientTypeCode      RecipientTypeCode
  recipientNameText      String
  transmissionBasisCode  TransmissionBasisCode
  transmissionReasonText String
  transmittedAt          DateTime
  transmittedByUserId    String?
  recordStatus           RecordStatus          @default(active)
  client                 Client                @relation(fields: [clientId], references: [id], onDelete: Cascade)
  session                Session?              @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  documentDerived        DocumentDerived       @relation(fields: [documentDerivedId], references: [id], onDelete: Cascade)
}

model ClientTimelineEvent {
  id               String       @id @default(cuid())
  clientId         String
  relatedSessionId String?
  eventTypeCode    EventTypeCode
  eventSummaryText String
  eventDate        DateTime
  createdAt        DateTime     @default(now())
  recordStatus     RecordStatus @default(active)
  client           Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  relatedSession   Session?     @relation(fields: [relatedSessionId], references: [id], onDelete: SetNull)

  @@index([clientId, eventDate])
}

model ReferentialVersion {
  id                   String               @id @default(cuid())
  referentialFamilyCode ReferentialFamilyCode
  versionCode          String
  effectiveFrom        DateTime
  effectiveTo          DateTime?
  compatibilityNotes   String?
  recordStatus         RecordStatus         @default(active)

  @@unique([referentialFamilyCode, versionCode])
}

model AuditEvent {
  id                   String               @id @default(cuid())
  actorTypeCode        ActorTypeCode
  actorUserId          String?
  targetObjectTypeCode TargetObjectTypeCode
  targetObjectId       String
  actionCode           ActionCode
  reasonText           String?
  metadataJson         Json?
  createdAt            DateTime             @default(now())
  recordStatus         RecordStatus         @default(active)

  @@index([targetObjectTypeCode, targetObjectId, createdAt])
}
