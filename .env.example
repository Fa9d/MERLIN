# Domains
IVIA_DOMAIN=ivia.quebec
IVIA_WWW_DOMAIN=www.ivia.quebec
IVIA_API_DOMAIN=api.ivia.quebec

# Postgres
POSTGRES_DB=merlin_v1
POSTGRES_USER=merlin
POSTGRES_PASSWORD=change-me

# Backend
MERLIN_ENV=production
MERLIN_APP_NAME=MERLIN API
MERLIN_API_V1_PREFIX=/api/v1
MERLIN_AUTH_SECRET_KEY=change-this-secret-in-prod
MERLIN_AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=120
MERLIN_MEDIA_PROVIDER_CODE=livekit
MERLIN_MEDIA_RECORDING_ENABLED=true
MERLIN_MEDIA_RECORDING_STRATEGY=livekit_egress
MERLIN_AUTO_CREATE_TABLES=false
MERLIN_CORS_ORIGINS=https://ivia.quebec,https://www.ivia.quebec,https://api.ivia.quebec

# Frontend
NEXT_PUBLIC_MERLIN_API_BASE_URL=https://api.ivia.quebec

# Anthropic / AssemblyAI
ANTHROPIC_API_KEY=
ASSEMBLYAI_API_KEY=

# LiveKit
LIVEKIT_URL=wss://livekit.ivia.quebec
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# LiveKit Egress storage
# local or s3
LIVEKIT_RECORDING_STORAGE=local
LIVEKIT_RECORDING_LOCAL_DIR=/app/storage/recordings

# OVH Object Storage / S3-compatible
LIVEKIT_S3_ENDPOINT=
LIVEKIT_S3_BUCKET=
LIVEKIT_S3_ACCESS_KEY=
LIVEKIT_S3_SECRET_KEY=
LIVEKIT_S3_REGION=
LIVEKIT_S3_FORCE_PATH_STYLE=true

# Certbot / Nginx ops
CERTBOT_EMAIL=ops@ivia.quebec
