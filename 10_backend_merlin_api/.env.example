MERLIN_ENV=development
MERLIN_APP_NAME=MERLIN API
MERLIN_API_V1_PREFIX=/api/v1
MERLIN_DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:55432/merlin_v1
MERLIN_AUTH_SECRET_KEY=change-this-secret-in-dev
MERLIN_AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=120
MERLIN_MEDIA_PROVIDER_CODE=livekit
MERLIN_MEDIA_LIVEKIT_WS_URL=
MERLIN_MEDIA_LIVEKIT_API_KEY=
MERLIN_MEDIA_LIVEKIT_API_SECRET=
MERLIN_MEDIA_RECORDING_ENABLED=true
MERLIN_MEDIA_RECORDING_STRATEGY=metadata_only
MERLIN_MEDIA_RECORDINGS_DIR=
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_RECORDING_STORAGE=local
LIVEKIT_RECORDING_LOCAL_DIR=
LIVEKIT_S3_ENDPOINT=
LIVEKIT_S3_BUCKET=
LIVEKIT_S3_ACCESS_KEY=
LIVEKIT_S3_SECRET_KEY=
LIVEKIT_S3_REGION=
LIVEKIT_S3_FORCE_PATH_STYLE=true
ASSEMBLYAI_API_KEY=
# Transcription : auto (faster-whisper si installé, sinon AssemblyAI) | faster_whisper | assemblyai
MERLIN_TRANSCRIPTION_PROVIDER=auto
MERLIN_WHISPER_MODEL=medium
MERLIN_WHISPER_DEVICE=cpu
MERLIN_WHISPER_COMPUTE_TYPE=int8
MERLIN_STRIPE_SECRET_KEY=
MERLIN_STRIPE_WEBHOOK_SECRET=
MERLIN_STRIPE_CHECKOUT_SUCCESS_URL=
MERLIN_STRIPE_CHECKOUT_CANCEL_URL=
MERLIN_STRIPE_AUDIO_ASYNC_AMOUNT_CENTS=4500
MERLIN_STRIPE_AUDIO_ASYNC_CURRENCY=cad
MERLIN_CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
MERLIN_AUTO_CREATE_TABLES=true
