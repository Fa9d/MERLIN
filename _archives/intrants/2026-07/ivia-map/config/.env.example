# ─────────────────────────────────────────────
# IVIA — Variables d'environnement
# Copier ce fichier en config/.env et remplir les valeurs
# NE JAMAIS committer config/.env dans le repo
# ─────────────────────────────────────────────

# ── OpenAI (Whisper + MERLIN GPT-4o) ──
OPENAI_API_KEY=sk-...

# ── Hume AI (analyse émotionnelle vocale) ──
HUME_API_KEY=hume-...

# ── API IVIA (backend principal) ──
IVIA_API_URL=https://api.ivia.app/v1
IVIA_API_KEY=ivia-...

# ── Pipeline audio ──
LANGUAGE=fr
AUDIO_MAX_SIZE_MB=25
AUDIO_KEEP_AFTER_PROCESSING=false

# ── Base de données ──
DATABASE_URL=postgresql://user:password@localhost:5432/ivia

# ── Auth ──
JWT_SECRET=changeme-32-chars-minimum
JWT_EXPIRES_IN=7d

# ── Environnement ──
NODE_ENV=development
PORT=3000
